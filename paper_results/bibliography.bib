@article{diab_understanding_2012,
	title = {Understanding the impacts of a combination of service improvement strategies on bus running time and passenger’s perception},
	volume = {46},
	issn = {0965-8564},
	url = {https://www.sciencedirect.com/science/article/pii/S0965856411001820},
	doi = {10.1016/j.tra.2011.11.013},
	abstract = {Transit agencies implement many strategies in order to provide an attractive transportation service. This article aims to evaluate the impacts of implementing a combination of strategies, designed to improve the bus transit service, on running time and passenger satisfaction. These strategies include using smart card fare collection, introducing limited-stop bus service, implementing reserved bus lanes, using articulated buses, and implementing transit signal priority ({TSP}). This study uses stop-level data collected from the Société de transport de Montréal ({STM})’s automatic vehicle location ({AVL}) and automatic passenger count ({APC}) systems, in Montréal, Canada. The combination of these strategies has lead to a 10.5\% decline in running time along the limited stop service compared to the regular service. The regular route running time has increased by 1\% on average compared to the initial time period. The study also shows that riders are generally satisfied with the service improvements. They tend to overestimate the savings associated with the implementation of this combination of strategies by 3.5–6.0min and by 2.5–4.1min for both the regular route and the limited stop service, respectively. This study helps transit planners and policy makers to better understand the effects of implementing a combination of strategies to improve running time and passenger’s perception of these changes in service.},
	pages = {614--625},
	number = {3},
	journaltitle = {Transportation Research Part A: Policy and Practice},
	shortjournal = {Transportation Research Part A: Policy and Practice},
	author = {Diab, Ehab I. and El-Geneidy, Ahmed M.},
	urldate = {2026-06-24},
	date = {2012-03-01},
	note = {Bus lane time reduction, frequency increase},
	keywords = {Articulated buses, Limited-stop bus service, Reserved lane, Running time, Smart card fare collection, Transit signal priority ({TSP})},
	file = {ScienceDirect Full Text PDF:/home/goncalo/Zotero/storage/HQKZH9CV/Diab and El-Geneidy - 2012 - Understanding the impacts of a combination of service improvement strategies on bus running time and.pdf:application/pdf;ScienceDirect Snapshot:/home/goncalo/Zotero/storage/NQN6AAU9/S0965856411001820.html:text/html},
}


@article{cordera_good_2024,
	title = {Good practices on transit operation design: bus drivers’ perspective},
	volume = {16},
	issn = {1866-8887},
	url = {https://doi.org/10.1186/s12544-024-00661-1},
	doi = {10.1186/s12544-024-00661-1},
	shorttitle = {Good practices on transit operation design},
	abstract = {Understanding which aspects can have the greatest influence on the performance, comfort and safety of a public transport system can be of great help in improving its operation and promoting more sustainable mobility. To find out more about these aspects, a survey was carried out among more than 180 drivers of urban bus transport systems in seven medium-sized cities in Spain. The drivers' perspective has been insufficiently taken into account in previous research, despite the fact that these workers have a high and direct knowledge of the operation and problems directly affecting the service. The data collected through this survey have been analysed using descriptive statistics and an Ordered Probit model. The results have allowed us to detect specific aspects to improve the performance and comfort of users and drivers such as the correct location and length of bus stops and enforcing regulation to ensure that buses have priority in traffic and that illegal parking does not interfere with their operations. In addition, bus lanes were seen as important by drivers to improve the comfort and safety of the service. Other factors related to safety were generally highly rated and there was little dispersion in the responses about their importance, although aspects such as proper visibility, avoiding illegal parking, and campaigns to encourage bus users to be aware of their surroundings stood out in the answers. Finally, the payment system was highlighted as very relevant to ensure the performance and comfort of users and drivers during the operation at bus stops. Improving this system was identified as the measure that could have the greatest impact on the performance of the service as a whole.},
	pages = {36},
	number = {1},
	journaltitle = {European Transport Research Review},
	shortjournal = {Eur. Transp. Res. Rev.},
	author = {Cordera, Rubén and Novales, Margarita and Orro, Alfonso and Alonso, Borja and dell’Olio, Luigi},
	urldate = {2026-06-24},
	date = {2024-06-20},
	langid = {english},
	note = {Bus drivers perspectives.},
	keywords = {Bus driver, Bus lane, Bus stop, Safety, Transit policy and design},
	file = {Full Text PDF:/home/goncalo/Zotero/storage/6SADTZ7R/Cordera et al. - 2024 - Good practices on transit operation design bus drivers’ perspective.pdf:application/pdf},
}


@article{vedagiri_estimating_2009,
	title = {Estimating Modal Shift of Car Travelers to Bus on Introduction of Bus Priority System},
	volume = {9},
	rights = {https://www.elsevier.com/tdm/userlicense/1.0/},
	issn = {15706672},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1570667208600926},
	doi = {10.1016/S1570-6672(08)60092-6},
	abstract = {This study is concerned with estimation of the probable shift of car users to bus due to increase in its level of service after providing exclusive bus lanes on Indian city roads carrying heterogeneous traffic. The quantum of increase in level of service of bus due to introduction of exclusive bus lane was determined using a recently developed simulation model of heterogeneous traffic flow. The data of the other factors (variables) that might cause modal shift from car to bus were collected through home-interview survey based on the stated preference approach. A binary Logit model of mode-choice was then calibrated using the collected data and the model was also validated using holdout sample. Through this study, a set of causal factors, with reliable and predictable data base, to explain the variation in shift behaviour of personal vehicle users to buses consequent on the increase in the level of service of buses, has been identified. A mode-choice probability curve to depict the possible modal shift of car users to bus is developed, taking the difference in travel times of the two-modes as the basis, to serve as a user friendly tool to analyze the possible modal shift for a wide range of values of the involved variable.},
	pages = {120--129},
	number = {6},
	journaltitle = {Journal of Transportation Systems Engineering and Information Technology},
	shortjournal = {Journal of Transportation Systems Engineering and Information Technology},
	author = {Vedagiri, P. and Arasan, V.T.},
	urldate = {2026-06-24},
	date = {2009-12},
	langid = {english},
	note = {Prob of changing to bus after bus lane implementation (time savings)},
	file = {PDF:/home/goncalo/Zotero/storage/UEGCK55R/Vedagiri and Arasan - 2009 - Estimating Modal Shift of Car Travelers to Bus on Introduction of Bus Priority System.pdf:application/pdf},
}


@article{mane_effect_2018,
	title = {Effect of bus-lane usage by private vehicles on modal shift},
	volume = {171},
	issn = {0965-092X, 1751-7710},
	url = {http://www.emerald.com/jtran/article/171/2/85-97/408763},
	doi = {10.1680/jtran.16.00127},
	abstract = {Developing countries urgently need to encourage the use of public transport. With this objective, in May 2013, the government of India implemented a bus rapid transit system ({BRTS}) with an exclusive bus lane in a rapidly growing city, Indore. However, after 6 months of successful {BRTS} service, the judicial system ordered that passenger cars should be allowed in the exclusive bus rapid transit lane; this unique decision motivated the present study. The objective is to assess the impact of {BRTS} service on modal shift before and after the introduction of private vehicles to the exclusive bus rapid transit lane. For these two cases, separate models are formulated and compared using the binary logistic method ({BLM}) and the artificial neural network ({ANN}) method. Data on demographic and socio-economic attributes (gender, age and occupation) and trip-related attributes (travel time details and cost saving per day) are collected using a revealed preference survey. An en-route on-board survey is conducted on passengers using buses along the study corridor. Owing to the introduction of vehicles in the exclusive bus rapid transit lane, the probability of passengers switching to the {BRTS} is observed to decrease from 64·7\% to 45·7\%. Moreover, {ANN} provides more accurate results than the {BLM} in both situations.},
	pages = {85--97},
	number = {2},
	journaltitle = {Proceedings of the Institution of Civil Engineers - Transport},
	shortjournal = {Proceedings of the Institution of Civil Engineers - Transport},
	author = {Mane, Ajinkya S. and Sarkar, Ashoke Kumar and Arkatkar, Shriniwas S. and Bhaskar, Ashish},
	urldate = {2026-06-24},
	date = {2018-04},
	langid = {english},
	note = {Survey. Modal share reduction after cars introduced in bus lanes},
	file = {PDF:/home/goncalo/Zotero/storage/3SZH4V2A/Mane et al. - 2018 - Effect of bus-lane usage by private vehicles on modal shift.pdf:application/pdf},
}



@article{russo_dedicated_2022,
	title = {Dedicated bus lanes, bus speed and traffic congestion in Rome},
	volume = {160},
	issn = {09658564},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0965856422000891},
	doi = {10.1016/j.tra.2022.04.001},
	abstract = {Buses are the mainstay of public transport systems in many cities but are typically subject to significant delays due to traffic congestion. We examine the welfare effects of providing dedicated bus lanes in the city of Rome, Italy. We demonstrate that a dedicated bus lane reduces bus travel time by about 18 percent. Our welfare analysis focuses on the situation where mixed road lanes are turned into dedicated bus lanes. We find that bus lanes are undersupplied, despite the additional time costs due to reducing road capacity available to cars.},
	pages = {298--310},
	journaltitle = {Transportation Research Part A: Policy and Practice},
	shortjournal = {Transportation Research Part A: Policy and Practice},
	author = {Russo, Antonio and Adler, Martin W. and Van Ommeren, Jos N.},
	urldate = {2026-05-22},
	date = {2022-06},
	langid = {english},
	note = {Avaliação impactos (tempos de viagem, modal shift, )},
	file = {PDF:/home/goncalo/Zotero/storage/XVFRDHM7/Russo et al. - 2022 - Dedicated bus lanes, bus speed and traffic congestion in Rome.pdf:application/pdf},
}


@article{wu_bus_1998,
	title = {Bus Priority Using pre-signals},
	volume = {32},
	issn = {0965-8564},
	url = {https://www.sciencedirect.com/science/article/pii/S0965856498000081},
	doi = {10.1016/S0965-8564(98)00008-1},
	abstract = {The need to provide efficient public transport services in urban areas has led to the implementation of bus priority measures in many congested cities. Much interest has recently centred on priority at signal controlled junctions, including the concept of pre-signals, where traffic signals are installed at or near the end of a with-flow bus lane to provide buses with priority access to the downstream junction. Although a number of pre-signals have now been installed in the U.K., particularly in London, there has been very little published research into their design, operation and optimisation. This paper addresses these points through the development of analytical procedures which allow pre-implementation evaluation of specific categories of pre-signals. The paper initially sets out three categories of pre-signal, which have different operating characteristics, different requirements for signalling and different impacts on capacity and delay. Key issues concerning signalling arrangements for these categories are then discussed, together with a summary of the analytical approach adopted and the assumptions required. Equations are developed to allow appropriate signal timings to be calculated for pre-signalised intersections. Further equations are then developed to enable delays to priority and non-priority traffic, with and without pre-signals, to be estimated with delay being taken here as the key performance criterion. The paper concludes with three application examples illustrating how the equations are applied and the impacts of pre-signals in different situations.The analyses confirm the potential benefits of pre-signals, where these signals apply to non-priority traffic only. Where buses are also subject to a pre-signal, it is shown that disbenefits to buses can often occur, unless bus detectors are used to gain priority signalling.},
	pages = {563--583},
	number = {8},
	journaltitle = {Transportation Research Part A: Policy and Practice},
	shortjournal = {Transportation Research Part A: Policy and Practice},
	author = {Wu, Jianping and Hounsell, Nick},
	urldate = {2026-06-24},
	date = {1998-11-01},
	note = {Pre-signals and how they can improve bus lane performance},
	keywords = {bus priority, pre-signal, public transport, queue relocation, traffic management},
	file = {ScienceDirect Full Text PDF:/home/goncalo/Zotero/storage/Y8TKAJEE/Wu and Hounsell - 1998 - Bus Priority Using pre-signals.pdf:application/pdf;ScienceDirect Snapshot:/home/goncalo/Zotero/storage/DU3ET28Z/S0965856498000081.html:text/html},
}


@article{uk_study_2005,
	title = {A {STUDY} {ON} {SETTING}-{UP} A {METHODOLOGY} {AND} {CRITERION} {OF} {EXCLUSIVE} {BUS} {LANE} {IN} {URBAN} {AREA}},
	volume = {5},
	abstract = {To ease traffic congestion in urban area exclusive bus lane has been operated by means of transportation demand management strategy. However, because criterion of busonly lane is not defined clearly, this strategy has been used indiscreetly. The purpose of this study is setting-up a methodology and criterion of exclusive bus lane using the point that makes the travel times between bus and automobile equal after operating it. This point is regarded as traveler equilibrium. If we find these criteria and use those effectively, we anticipate improving availability of bus and decreasing traffic congestion ultimately by deploying the exclusive bus lane. To perform this study, we use the traffic simulation package, {NETSIM}, and review real two areas such as Kangnamdaero, or the Kangnam Road in southern Seoul and Sejongro/Taepyongro in northern Seoul. As a result, it is analyzed that the exclusive bus lane is useful only above particular points that correspond to specific total traffic volume and bus volume. But this study has some limitations that bus lane is operated only on median lane and the number of sample area is small. So this aspect needs to be considered later.},
	journaltitle = {Proceedings of the Eastern Asia Society for Transportation Studies},
	author = {Uk, Young and Hwan, Jun},
	date = {2005},
	langid = {english},
	note = {Microsimulação, avalia impactos apenas. Travel time.},
	file = {PDF:/home/goncalo/Zotero/storage/KPJB6FZY/Uk e Hwan - 2005 - A STUDY ON SETTING-UP A METHODOLOGY AND CRITERION OF EXCLUSIVE BUS LANE IN URBAN AREA.pdf:application/pdf},
}


@inproceedings{wang_method_2024,
	location = {Guangzhou China},
	title = {A Method for Evaluating Urban Bus Lane Configuration Schemes Based on {VISSIM}},
	isbn = {979-8-4007-1066-7},
	url = {https://dl.acm.org/doi/10.1145/3704657.3704691},
	doi = {10.1145/3704657.3704691},
	abstract = {The construction of bus lanes is a pivotal measure in implementing the concept of prioritizing public transportation. Under the guidance of sustainable transportation system development requirements, a contemporary evaluation indicator system is essential to ensure that the establishment of bus lanes in urban traffic networks achieves the goal of enhancing efficiency and quality. This study, grounded in an analysis of urban public transportation characteristics and the operational features of major road traffic flows, constructs a comprehensive evaluation index system encompassing transportation efficiency, comparative benefits, and social benefits. Leveraging {VISSIM} simulation, complemented by principal component analysis and comparative analysis methods, a benefit evaluation methodology for urban bus lane configuration schemes based on this comprehensive index system is formulated. Taking the Yanta West Road section of Zhuque Street in Xi’an as a case study, two alternative bus lane configuration schemes are evaluated separately. Through comparative analysis of the indicators, a more suitable bus lane setup scheme for the city is determined.},
	eventtitle = {{IDST} 2024: 2024 International Conference on Intelligent Driving and Smart Transportation},
	pages = {198--208},
	booktitle = {Proceedings of the 2024 International Conference on Intelligent Driving and Smart Transportation},
	publisher = {{ACM}},
	author = {Wang, Jiafei and Zhang, Zengzhi and Zhao, Tiecong},
	urldate = {2026-05-20},
	date = {2024-10-25},
	langid = {english},
	note = {Microsimulação para avaliar impactos. Outputs: time savings, modal shift and emissions reduction},
	file = {PDF:/home/goncalo/Zotero/storage/WHFFS82W/Wang et al. - 2024 - A Method for Evaluating Urban Bus Lane Configuration Schemes Based on VISSIM.pdf:application/pdf},
}


@article{sun_combinatorial_2017,
	title = {Combinatorial optimization of bus lane infrastructure layout and bus operation management},
	volume = {9},
	issn = {1687-8140, 1687-8140},
	url = {http://journals.sagepub.com/doi/10.1177/1687814017703341},
	doi = {10.1177/1687814017703341},
	abstract = {Transit priority is considered as an effective way to relieve traffic congestion. As an efficient measure of executing transit priority, the exclusive bus lane design problem has become a research hotspot in the field of urban transportation planning. The aim of this study is to find the optimal combination of bus lane infrastructure planning (such as exclusive bus lane layout) and bus operation management (such as bus frequency). This combinatorial optimization problem is formulated in the form of a multi-objective bi-level programming model that minimizes system travel time, total pollutant emission, and bus operating cost simultaneously. A solution framework that implements a non-dominated sorting genetic algorithm is developed to efficiently solve the model. With an example network which is based on a part of Beijing’s road network, the proposed methodology is tested and its efficiency is verified by the numerical results.},
	pages = {168781401770334},
	number = {9},
	journaltitle = {Advances in Mechanical Engineering},
	shortjournal = {Advances in Mechanical Engineering},
	author = {Sun, Xu and Wu, Juan},
	urldate = {2026-05-20},
	date = {2017-09},
	langid = {english},
	note = {Assuming {OD} and infrastructure, optimizes and outputs bus lane network + bus frequencies. Does not act uppon existing operations.},
	file = {PDF:/home/goncalo/Zotero/storage/LMI8UEHN/Sun and Wu - 2017 - Combinatorial optimization of bus lane infrastructure layout and bus operation management.pdf:application/pdf},
}


@article{tsitsokas_modeling_2021,
	title = {Modeling and optimization of dedicated bus lanes space allocation in large networks with dynamic congestion},
	volume = {127},
	issn = {0968090X},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0968090X21001042},
	doi = {10.1016/j.trc.2021.103082},
	abstract = {Dedicated bus lanes provide a low cost and easily implementable strategy to improve transit service by minimizing congestion-related delays. Identifying the best spatial distribution of busonly lanes in order to maximize traffic performance of an urban network while balancing the trade-off between bus priority and regular traffic disturbance is a challenging task. This paper studies the problem of optimal dedicated bus lane allocation and proposes a modeling framework based on a link-level dynamic traffic modeling paradigm, which is compatible with the dynamic characteristics of congestion propagation that can be correlated with bus lane relative positions. The problem is formulated as a non-linear combinatorial optimization problem with binary variables. An algorithmic scheme based on a problem-specific heuristic and Large Neighborhood Search metaheuristic, potentially combined with a network decomposition technique and a performance-based learning process for increased efficiency, is proposed for deriving good quality solutions for large-scale network instances. Numerical application results for a real city center demonstrate the efficiency of the proposed framework in finding effective bus lane network configurations; when compared to the initial network state they exhibit the potential of bus lanes to improve travel time for car and bus users.},
	pages = {103082},
	journaltitle = {Transportation Research Part C: Emerging Technologies},
	shortjournal = {Transportation Research Part C: Emerging Technologies},
	author = {Tsitsokas, Dimitrios and Kouvelas, Anastasios and Geroliminis, Nikolas},
	urldate = {2026-05-20},
	date = {2021-06},
	langid = {english},
	note = {Algorithm to prioritize. Assumes geometrical, topological, and traffic characteristics of the network are known.},
	file = {PDF:/home/goncalo/Zotero/storage/JU5GPSAL/1-s2.0-S0968090X21001042-main.pdf:application/pdf},
}

